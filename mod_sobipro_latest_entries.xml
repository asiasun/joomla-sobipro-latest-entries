<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="3.0" client="site" method="upgrade">
	<name>MOD_SOBIPRO_LATEST_ENTRIES</name>
	<author>F.Yousefi</author>
	<authorEmail>asiasunnet@gmail.com</authorEmail>
	<authorUrl>https://www.asiasun.ir</authorUrl>
	<creationDate>2026-10-10</creationDate>
	<copyright>(C) 2026 AsiaSun.ir, Pvt. Ltd. All rights reserved</copyright>
	<license>GNU/GPL http://www.gnu.org/copyleft/gpl.html</license>
	<version>2.1.0</version>
	<description>MOD_SOBIPRO_LATEST_ENTRIES_XML_DESCRIPTION</description>

	<files>
		<filename module="mod_sobipro_latest_entries">mod_sobipro_latest_entries.php</filename>
		<filename>helper.php</filename>
		<filename>index.html</filename>
		<filename>CHANGELOG.md</filename>
		<filename>README.md</filename>
		<filename>LICENSE</filename>
		<folder>tmpl</folder>
		<folder>assets</folder>
		<folder>language</folder>
	</files>

	<languages>
		<language tag="en-GB">language/en-GB/en-GB.mod_sobipro_latest_entries.ini</language>
		<language tag="en-GB">language/en-GB/en-GB.mod_sobipro_latest_entries.sys.ini</language>
		<language tag="fa-IR">language/fa-IR/fa-IR.mod_sobipro_latest_entries.ini</language>
		<language tag="fa-IR">language/fa-IR/fa-IR.mod_sobipro_latest_entries.sys.ini</language>
	</languages>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="items_count" type="number" default="8" filter="integer" label="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_ITEMS_COUNT" />
				<field name="section_id" type="text" default="1" filter="integer" label="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_SECTION" />
				<field name="sort_field_id" type="text" default="49" filter="integer" label="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_SORT_FID" description="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_SORT_FID_DESC" />
				<field name="title_field_id" type="text" default="1" filter="integer" label="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_TITLE_FID" />
				<field name="cover_field_id" type="text" default="48" filter="integer" label="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_COVER_FID" description="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_COVER_FID_DESC" />
				<field name="banner_field_id" type="text" default="62" filter="integer" label="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_BANNER_FID" description="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_BANNER_FID_DESC" />
				<field name="category_field_id" type="text" default="77" filter="integer" label="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_CATEGORY_FID" description="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_CATEGORY_FID_DESC" />
				<field name="entry_base_path" type="text" default="game-profile" label="MOD_SOBIPRO_LATEST_ENTRIES_FIELD_BASE_PATH" />
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" description="JFIELD_ALT_MODULE_LAYOUT_DESC" />
				<field name="moduleclass_sfx" type="textarea" rows="3" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" description="COM_MODULES_FIELD_MODULECLASS_SFX_DESC" />
				<field name="cache" type="list" default="1" filter="integer" label="COM_MODULES_FIELD_CACHING_LABEL">
					<option value="1">JGLOBAL_USE_GLOBAL</option>
					<option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option>
				</field>
				<field name="cache_time" type="number" default="900" filter="integer" label="COM_MODULES_FIELD_CACHE_TIME_LABEL" />
				<field name="cachemode" type="hidden" default="static" />
			</fieldset>
		</fields>
	</config>

	<updateservers>
		<server type="extension" priority="1" name="SobiPro Latest Entries Updates">https://www.asiasun.ir/updates/mod_sobipro_latest_entries.xml</server>
	</updateservers>
</extension>
